#!/usr/bin/env bash
# FullPageOS: start_chromium_browser with one-time splash flow
# Runs as user 'pi' inside the LightDM session. Cleanup/reboot are handled by systemd (root).

set -u  # don't use -e; we want to keep the session alive even if something small fails

FIRSTBOOT_FLAG="/etc/firstboot-splash"
UI_STARTED="/tmp/firstboot-ui-started"
WAIT_HTML="/home/pi/wait.html"
FLASH_UNIT="flash_once.service"       # <— your service name here
LOG="/tmp/firstboot-kiosk.log"

flags=(
  --kiosk
  --ozone-platform=wayland
  --touch-events=enabled
  --disable-pinch
  --noerrdialogs
  --no-memcheck
  --no-first-run
  --no-default-browser-check
  --disable-features=MemorySaverFeatureNotification,HighEfficiencyModeAvailable
  --disable-session-crashed-bubble
  --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT'
  --disable-component-update
  --overscroll-history-navigation=0
  --disable-features=TranslateUI
  --autoplay-policy=no-user-gesture-required
  --disk-cache-size=500000000
  --load-extension=/home/pi/virtual_keyboard
)

# ---------- One-time splash branch ----------
if [[ -f "$FIRSTBOOT_FLAG" ]]; then
  {
    echo "[$(date)] firstboot: flag present"

    # Let the systemd unit know the UI path has started
    touch "$UI_STARTED"

    CHROME_BIN="$(command -v chromium-browser || command -v chromium || true)"
    if [[ -z "${CHROME_BIN:-}" ]]; then
      echo "[$(date)] firstboot: chromium not found; skipping splash"
      exit 0
    fi
    if [[ ! -f "$WAIT_HTML" ]]; then
      echo "[$(date)] firstboot: $WAIT_HTML missing; skipping splash"
      exit 0
    fi

    PROFILE="/home/pi/.config/chromium-firstboot"
    mkdir -p "$PROFILE"; chown -R pi:pi "$PROFILE" || true

    # Remove any stale Singleton lock from a previous (unclean) session.
    # On update reboots this is the CORRECT profile dir — NOT ~/.config/chromium.
    rm -f "${PROFILE}"/Singleton* 2>/dev/null || true

    # NOTE: file:/// (three slashes) is required
    nohup "$CHROME_BIN" \
      --user-data-dir="$PROFILE" \
      --app="file:///home/pi/wait.html" \
      --allow-file-access-from-files \
      --hide-scrollbars \
      "${flags[@]}" \
      >/tmp/firstboot-chrome.log 2>&1 &
    CHROME_PID=$!

    echo "[$(date)] firstboot: started splash (PID $CHROME_PID); starting $FLASH_UNIT"
    systemctl start "$FLASH_UNIT" || true

    # Block until Chromium exits — this prevents run_onepageos from looping back
    # and launching a second Chromium against the same profile (causing a lock error).
    # On success flash_once clears firstboot-splash and the system is power-cycled by
    # the user; on reboot Chromium is killed and this wait returns naturally.
    CHROME_START=$SECONDS
    wait "$CHROME_PID" 2>/dev/null || true
    CHROME_RUNTIME=$(( SECONDS - CHROME_START ))

    echo "[$(date)] firstboot: chromium exited after ${CHROME_RUNTIME}s"

    # --- Last-resort fallback: if Chromium keeps dying almost immediately it never
    #     showed the splash page.  After 3 consecutive quick-exits give up on the
    #     firstboot flow entirely and fall through to the normal kiosk UI so the
    #     machine is usable rather than stuck on a blank desktop forever.
    FAIL_FILE="/tmp/firstboot-chrome-fails"
    if (( CHROME_RUNTIME < 15 )); then
      FAILS=$(( $(cat "$FAIL_FILE" 2>/dev/null || echo 0) + 1 ))
      echo "$FAILS" > "$FAIL_FILE"
      echo "[$(date)] firstboot: quick-exit #${FAILS} — splash may not have appeared"
      if (( FAILS >= 3 )); then
        echo "[$(date)] firstboot: 3 consecutive quick-exits; giving up — clearing firstboot flag and falling back to normal UI"
        systemctl stop "$FLASH_UNIT" 2>/dev/null || true
        rm -f /etc/firstboot-splash /tmp/firstboot-ui-started "$FAIL_FILE"
      fi
    else
      # Chromium ran long enough — reset the failure counter
      rm -f "$FAIL_FILE"
      echo "[$(date)] firstboot: leaving cleanup/reboot to systemd"
    fi
  } >>"$LOG" 2>&1
  exit 0
fi
# ---------- End first-boot branch ----------

# ---------- Normal kiosk behavior ----------
CHROME_BIN="$(command -v chromium-browser || command -v chromium || true)"
if [[ -n "${CHROME_BIN:-}" ]]; then
  "$CHROME_BIN" "${flags[@]}" --app=$(/opt/custompios/scripts/get_url)
  exit 0
fi

# Fallback signage mode (unchanged)
chromium-browser --enable-logging --log-level=2 --v=0 "${flags[@]}" --app=$(/opt/custompios/scripts/get_url) &

export logfile="/home/$(id -nu 1000)/.config/chromium/chrome_debug.log"
tail -n 0 -F "$logfile" | while read -r LOGLINE; do
  echo "Refreshing after crash"
  echo "Restarting at $(date) after a reported crash. Logline: ${LOGLINE}" >> /tmp/crashlog
  [[ "$LOGLINE" == *"ERROR"* || "$LOGLINE" == *"FATAL"* ]] && /home/$(id -nu 1000)/scripts/refresh
done