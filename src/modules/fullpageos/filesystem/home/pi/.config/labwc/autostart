#!/bin/sh
# re3D-OS labwc kiosk autostart
# This file is executed by labwc when the Wayland session starts.

# VNC server for remote access (if installed)
if command -v wayvnc >/dev/null 2>&1; then
  wayvnc --render-cursor 0.0.0.0 5900 &
fi

# Display mode: read flag file to choose the frontend.
# "mainsail"      → Chromium kiosk showing Mainsail (default)
# "klipperscreen" → KlipperScreen native Wayland app
MODE=$(cat /etc/re3d-display-mode 2>/dev/null || echo "mainsail")

if [ "$MODE" = "klipperscreen" ]; then
  exec /opt/custompios/scripts/start_klipperscreen
else
  exec /opt/custompios/scripts/run_onepageos
fi
