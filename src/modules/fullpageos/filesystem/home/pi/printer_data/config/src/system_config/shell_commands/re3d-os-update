#!/usr/bin/env bash
set -euo pipefail

BRANCH="${1:-devel}"   # default branch/tag to track
REPO_DIR="/opt/re3d-os-src"
REPO_URL="https://github.com/re3Dprinting/re3D-Klipper-OS.git"
REAL_SCRIPT="${REPO_DIR}/tools/re3d-os-update.sh"
LOG_TAG="[re3D-OS bootstrap]"

echo "${LOG_TAG} Using branch/tag: ${BRANCH}"
echo "${LOG_TAG} Repo dir:   ${REPO_DIR}"
echo "${LOG_TAG} Real script:${REAL_SCRIPT}"

# --- Ensure git is available ---
if ! command -v git >/dev/null 2>&1; then
  echo "${LOG_TAG} ERROR: 'git' is not installed."
  echo "${LOG_TAG}        Install it with: sudo apt-get update && sudo apt-get install -y git"
  exit 1
fi

# --- Ensure repo exists (clone on first run) ---
if [ ! -d "${REPO_DIR}/.git" ]; then
  echo "${LOG_TAG} No repo found at ${REPO_DIR}, cloning..."
  mkdir -p "$(dirname "${REPO_DIR}")"
  git clone "${REPO_URL}" "${REPO_DIR}"
  cd "${REPO_DIR}"
else
  echo "${LOG_TAG} Existing repo found, updating..."
  cd "${REPO_DIR}"
  git fetch origin
fi

# --- Move to requested branch/tag if possible ---
if git show-ref --verify --quiet "refs/remotes/origin/${BRANCH}"; then
  echo "${LOG_TAG} Checking out origin/${BRANCH}..."
  git checkout -B "${BRANCH}" "origin/${BRANCH}"
elif git show-ref --verify --quiet "refs/tags/${BRANCH}"; then
  echo "${LOG_TAG} Checking out tag ${BRANCH}..."
  git checkout -f "refs/tags/${BRANCH}"
else
  echo "${LOG_TAG} WARNING: Branch or tag '${BRANCH}' not found; staying on current HEAD."
fi

# --- Hand off to real updater inside repo ---
if [ ! -x "${REAL_SCRIPT}" ]; then
  echo "${LOG_TAG} ERROR: ${REAL_SCRIPT} not found or not executable."
  exit 1
fi

echo "${LOG_TAG} Handing off to ${REAL_SCRIPT}..."
exec "${REAL_SCRIPT}" "${BRANCH}"
