#!/usr/bin/env python3
"""
sg_watch - Live StallGuard monitor via Moonraker API.

Polls Moonraker's printer-objects endpoint independently of the GCode queue,
so it works while a print is running without interfering with it at all.

Usage (from SSH):
  sg_watch                    live display, 0.5 s poll (default)
  sg_watch 0.1                live display, 100 ms poll
  sg_watch -r                 live display + record CSV, graph on exit
  sg_watch 0.1 -r             fast poll + record
  sg_watch -r --out /tmp/run  save run.csv and run.png to /tmp/

Deployed to /usr/local/bin/sg_watch by the re3D-OS updater.
"""

import sys
import time
import json
import csv
import os
import datetime
import argparse
import urllib.request
import urllib.error

MOONRAKER_URL   = "http://localhost/printer/objects/query?stallguard_monitor"
DEFAULT_OUT_DIR = os.path.expanduser("~/printer_data/logs")

# ANSI helpers
CSI   = "\033["
CLEAR = CSI + "2J" + CSI + "H"
BOLD  = CSI + "1m"
RED   = CSI + "31m"
YEL   = CSI + "33m"
GRN   = CSI + "32m"
RST   = CSI + "0m"

BAR_WIDTH = 32


# ── HTTP fetch ────────────────────────────────────────────────────────────────

def fetch():
    try:
        with urllib.request.urlopen(MOONRAKER_URL, timeout=2) as resp:
            return json.loads(resp.read()), None
    except urllib.error.URLError as e:
        return None, "Moonraker unreachable: {}".format(e.reason)
    except Exception as e:
        return None, str(e)


# ── Display helpers ───────────────────────────────────────────────────────────

def sg_bar(val, threshold, max_val=1023):
    filled = int(val / max_val * BAR_WIDTH)
    filled = max(0, min(filled, BAR_WIDTH))
    color  = RED if val < threshold else (YEL if val < threshold * 2 else GRN)
    return "[" + color + "#" * filled + RST + "-" * (BAR_WIDTH - filled) + "]"


# ── Graph generation ──────────────────────────────────────────────────────────

def generate_graph(csv_path, png_path, threshold):
    """Read a recorded CSV and write a PNG graph using matplotlib."""
    try:
        import matplotlib
        matplotlib.use("Agg")   # headless - no display required
        import matplotlib.pyplot as plt
        import matplotlib.dates as mdates
    except ImportError:
        print("  matplotlib not available - skipping graph (install python3-matplotlib)")
        return

    # Parse CSV: timestamp, motor, sg_result, threshold, collision_latched
    series = {}   # motor -> ([datetime], [int])
    with open(csv_path, newline="") as f:
        for row in csv.DictReader(f):
            motor = row["motor"]
            if motor not in series:
                series[motor] = ([], [])
            try:
                ts  = datetime.datetime.fromisoformat(row["timestamp"])
                val = int(row["sg_result"])
                series[motor][0].append(ts)
                series[motor][1].append(val)
            except (ValueError, KeyError):
                pass

    if not series:
        print("  No data in CSV - skipping graph.")
        return

    motors    = sorted(series.keys())
    n         = len(motors)
    fig, axes = plt.subplots(n, 1, figsize=(14, 3 * n), sharex=True)
    if n == 1:
        axes = [axes]

    fig.suptitle("StallGuard Recording  --  {}".format(os.path.basename(csv_path)),
                 fontsize=11)

    for ax, motor in zip(axes, motors):
        times, vals = series[motor]
        if not times:
            continue

        # Shade regions below threshold red
        ax.fill_between(times, vals, threshold,
                        where=[v < threshold for v in vals],
                        color="red", alpha=0.25, label="below threshold")
        ax.plot(times, vals, linewidth=0.8, color="steelblue", label="SG_RESULT")
        ax.axhline(threshold, color="red", linestyle="--",
                   linewidth=1.0, label="threshold={}".format(threshold))

        ax.set_ylabel(motor, fontsize=9)
        ax.set_ylim(0, 1023)
        ax.set_yticks([0, 256, 512, 768, 1023])
        ax.grid(True, alpha=0.3)
        ax.legend(loc="upper right", fontsize=7)
        ax.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M:%S"))

    axes[-1].set_xlabel("Time")
    plt.xticks(rotation=30, ha="right", fontsize=8)
    plt.tight_layout()
    fig.savefig(png_path, dpi=120)
    plt.close(fig)
    print("  Graph saved : {}".format(png_path))


# ── Entry point ───────────────────────────────────────────────────────────────

def parse_args():
    p = argparse.ArgumentParser(
        prog="sg_watch",
        description="Live StallGuard monitor (Moonraker API, independent of GCode queue)")
    p.add_argument("interval", nargs="?", type=float, default=0.5,
                   help="Poll interval in seconds (default 0.5, min 0.02)")
    p.add_argument("-r", "--record", action="store_true",
                   help="Record readings to CSV and generate a PNG graph on exit")
    p.add_argument("--out", default=None,
                   help="Base path for output files (auto-timestamped in ~/printer_data/logs/ by default)")
    return p.parse_args()


if __name__ == "__main__":
    args          = parse_args()
    args.interval = max(0.02, min(args.interval, 60.0))

    if args.record and args.out is None:
        ts       = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        os.makedirs(DEFAULT_OUT_DIR, exist_ok=True)
        args.out = os.path.join(DEFAULT_OUT_DIR, "sg_{}".format(ts))

    # mutable so the KeyboardInterrupt handler sees the updated value
    threshold = [100]
    history   = {}
    recording = []

    if args.record:
        print("Recording to : {}".format(args.out + ".csv"))
        print("Graph will be: {}".format(args.out + ".png"))
        print("Press Ctrl+C to stop and generate the graph.")
        time.sleep(1.5)

    try:
        while True:
            data, err = fetch()
            now       = datetime.datetime.now()
            now_str   = now.strftime("%H:%M:%S.%f")[:-3]

            print(CLEAR, end="")
            rec_tag = (" {}[REC]{}  {}".format(RED, RST, os.path.basename(args.out + ".csv"))
                       if args.record else "  Ctrl+C to stop")
            print("{}StallGuard Live Monitor{}  {}  {:.2f}s{}".format(
                BOLD, RST, now_str, args.interval, rec_tag))
            print()

            if err:
                print("  {}ERROR:{} {}".format(RED, RST, err))
                time.sleep(args.interval)
                continue

            sg = (data.get("result", {})
                      .get("status", {})
                      .get("stallguard_monitor", {}))

            if not sg:
                print("  {}WARNING:{} stallguard_monitor not in Moonraker response.".format(YEL, RST))
                print("  Check [stallguard_monitor] in printer.cfg.")
                time.sleep(args.interval)
                continue

            values       = sg.get("sg_values", {})
            threshold[0] = sg.get("collision_threshold", threshold[0])
            detected     = sg.get("collision_detected", False)
            monitoring   = sg.get("enabled", False)

            mon_str  = (GRN + "ON"  + RST) if monitoring else (YEL + "OFF" + RST)
            coll_str = (RED + BOLD + "!! COLLISION LATCHED !!" + RST) if detected \
                       else (GRN + "clear" + RST)

            print("  monitoring={}  threshold={}  collision={}".format(
                mon_str, threshold[0], coll_str))
            print()
            print("  {:<16}  {:>10}  {:<{bw}}  {:>6}  {:>6}".format(
                "motor", "SG_RESULT", "load", "min", "max", bw=BAR_WIDTH + 2))
            print("  " + "-" * 74)

            for motor in sorted(values.keys()):
                val = values[motor]

                if motor not in history:
                    history[motor] = []
                if val is not None:
                    history[motor].append(val)
                    if len(history[motor]) > 500:
                        history[motor].pop(0)
                    if args.record:
                        recording.append({
                            "timestamp":         now.isoformat(),
                            "motor":             motor,
                            "sg_result":         val,
                            "threshold":         threshold[0],
                            "collision_latched": int(detected),
                        })

                if val is None:
                    print("  {:<16}  {:>10}".format(motor, "N/A"))
                    continue

                hist = history[motor]
                lo   = min(hist) if hist else val
                hi   = max(hist) if hist else val
                bar  = sg_bar(val, threshold[0])
                note = "{}<<< LOW{}".format(RED, RST) if val < threshold[0] else ""
                print("  {:<16}  {:>10}  {}  {:>6}  {:>6}  {}".format(
                    motor, val, bar, lo, hi, note))

            if args.record:
                print()
                print("  {} samples recorded".format(len(recording)))

            time.sleep(args.interval)

    except KeyboardInterrupt:
        print("\n\nStopped.")
        if args.record and recording:
            csv_path = args.out + ".csv"
            png_path = args.out + ".png"
            print("Writing CSV  : {}".format(csv_path))
            with open(csv_path, "w", newline="") as f:
                w = csv.DictWriter(f, fieldnames=[
                    "timestamp", "motor", "sg_result", "threshold", "collision_latched"])
                w.writeheader()
                w.writerows(recording)
            print("  {} rows written.".format(len(recording)))
            generate_graph(csv_path, png_path, threshold[0])
        elif args.record:
            print("  No data recorded.")