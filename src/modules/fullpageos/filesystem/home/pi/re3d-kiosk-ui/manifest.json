{
  "manifest_version": 3,
  "name": "re3D Kiosk UI",
  "version": "1.3.0",
  "description": "Touchscreen navigation, external-page return controls, and Mainsail shortcut visibility.",
  "permissions": ["tabs", "storage", "webNavigation", "alarms"],
  "host_permissions": ["http://localhost:8081/*"],
  "background": { "service_worker": "external-background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["mainsail.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
      "js": ["kiosk-client.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["external-navigation.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
      "js": ["designs-client.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.thingiverse.com/re3dprinting/designs*", "https://thingiverse.com/re3dprinting/designs*"],
      "js": ["thingiverse-collector.js"],
      "run_at": "document_idle"
    }
  ]
}
