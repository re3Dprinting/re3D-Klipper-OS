[Unit]
Description=re3D pi password helper
Before=re3d-auth.service

[Service]
User=root
Group=re3d-auth
RuntimeDirectory=re3d-ssh-password
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /opt/mconfig/ssh_password.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
# full makes /etc read-only even with a same-path writable exception on systemd 252.
ProtectSystem=strict
ReadWritePaths=/etc
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
