[Unit]
Description=One-time flash task shown behind splash
ConditionPathExists=/etc/firstboot-splash
After=network.target

[Service]
Type=simple
# Wait up to 300 s for the splash UI to appear before starting the flash logic.
ExecStartPre=-/bin/bash -c 'n=0; while [ $n -lt 300 ] && ! [ -f /tmp/firstboot-ui-started ]; do sleep 1; n=$((n+1)); done'
ExecStart=-/usr/local/bin/flash_once.sh
RuntimeMaxSec=7200

[Install]
WantedBy=multi-user.target
