[Unit]
Description=re3D air-gap settings and physical keyboard filter
Requires=re3d-airgap.service
After=re3d-airgap.service
Before=re3d-auth.service display-manager.service

[Service]
Type=notify
NotifyAccess=main
User=root
Group=re3d-auth
ExecStart=/usr/bin/python3 /opt/mconfig/airgap.py --serve
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/re3d-airgap /run/re3d-airgap
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
