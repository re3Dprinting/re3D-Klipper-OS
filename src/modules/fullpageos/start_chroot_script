#!/usr/bin/env bash
# FullPageOS generation script
# Helper script that runs in a Raspbian/others chroot to create the FullPageOS distro
# Written by Guy Sheffer <guysoft at gmail dot com>
# GPL V3
########
set -x
set -e

# --- Build Timing Setup ---
BUILD_TIMING_LOG="/tmp/build_timing.log"
echo "" > "$BUILD_TIMING_LOG"
step_start() { STEP_NAME="$1"; STEP_TIME=$(date +%s); }
step_end() { local end_time=$(date +%s); local elapsed=$((end_time-STEP_TIME)); echo "$STEP_NAME: ${elapsed}s" >> "$BUILD_TIMING_LOG"; }

source /common.sh

echo "=== Checking for host cache ==="
ls -lah /host_cache || echo "No /host_cache found"

apt-get install -y rsync
set -e
CACHE_ROOT="/host_cache"
USER_HOME="/home/${BASE_USER}"

# --- Make repo available on the image for runtime updates (if /src exists) ---
if [ -d /opt/re3d-os-src/.git ]; then
  echo "[re3D-OS] /opt/re3d-os-src already exists; skipping repo copy."
else
  if [ -d /src/.git ]; then
    echo "[re3D-OS] Copying /src → /opt/re3d-os-src (includes .git)..."
    mkdir -p /opt
    cp -a /src /opt/re3d-os-src
  else
    echo "[re3D-OS] WARNING: /src not found in chroot; skipping embedded repo."
    echo "[re3D-OS]          You will need to clone to /opt/re3d-os-src on the live system."
  fi
fi
# --- end re3D-OS repo block ---

seed_dir () {
  local src="$1"     # e.g. /host_cache/klipper
  local dst="$2"     # e.g. /home/pi/klipper
  local owner="${BASE_USER}:${BASE_USER}"

  if [ -d "$src" ]; then
    echo "Seeding cache: $src -> $dst"
    mkdir -p "$dst"
    rsync -a --delete "$src/" "$dst/"
    chown -R "$owner" "$dst"
  else
    echo "No cache found for $dst"
  fi
}

step_start "Unpack Filesystem"
unpack /filesystem/home/pi /home/"${BASE_USER}" "${BASE_USER}"
unpack /filesystem/opt /opt
unpack /filesystem/boot /"${BASE_BOOT_MOUNT_PATH}"
unpack /filesystem/root_init /
unpack /filesystem/host_cache /host_cache
step_end

apt-get update
install -d -m 1777 /tmp && chown root:root /tmp

# Seed Klipper / Moonraker / Crowsnest and their venvs if present (after unpack so /host_cache exists)
step_start "Seed host_cache into chroot"
seed_dir "${CACHE_ROOT}/klipper"        "${USER_HOME}/klipper"
seed_dir "${CACHE_ROOT}/klippy-env"     "${USER_HOME}/klippy-env"
seed_dir "${CACHE_ROOT}/moonraker"      "${USER_HOME}/moonraker"
seed_dir "${CACHE_ROOT}/moonraker-env"  "${USER_HOME}/moonraker-env"
#seed_dir "${CACHE_ROOT}/crowsnest"      "${USER_HOME}/crowsnest"

# If present, restore prebuilt Crowsnest binaries BEFORE deleting /host_cache
CROWSNEST_PREINSTALLED=0
BIN_SRC="${CACHE_ROOT}/crowsnest-binaries"
if [ -x "${BIN_SRC}/ustreamer" ] && [ -x "${BIN_SRC}/camera-streamer" ]; then
  echo "CROWSNEST FAST-PATH: installing prebuilt binaries from cache"
  install -Dm0755 "${BIN_SRC}/ustreamer"       /usr/local/bin/ustreamer
  install -Dm0755 "${BIN_SRC}/camera-streamer" /usr/local/bin/camera-streamer
  [ -x "${BIN_SRC}/crowsnest" ] && install -Dm0755 "${BIN_SRC}/crowsnest" /usr/local/bin/crowsnest
  [ -f "${BIN_SRC}/crowsnest.service" ] && install -Dm0644 "${BIN_SRC}/crowsnest.service" /lib/systemd/system/crowsnest.service
  systemctl daemon-reload || true
  systemctl enable crowsnest || true
  CROWSNEST_PREINSTALLED=1
fi

# Reclaim space BEFORE pip installs
rm -rf "${CACHE_ROOT}" || true
apt-get clean
# NOTE: do NOT purge /var/lib/apt/lists/* here or you'll need to apt-get update again
df -h / || true

# If we seeded venvs, make sure wheels are up-to-date with requirements
sudo -u "${BASE_USER}" bash -lc '
  set -e
  if [ -w /tmp ]; then
    export TMPDIR=/tmp
  else
    mkdir -p "$HOME/.tmp"; chmod 700 "$HOME/.tmp"; export TMPDIR="$HOME/.tmp"
  fi

  df -h / || true
  df -h "$TMPDIR" || true

  if [ -d "$HOME/klippy-env" ] && [ -d "$HOME/klipper" ]; then
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    source "$HOME/klippy-env/bin/activate"
    pip install -U pip setuptools wheel --no-cache-dir
    [ -f "$HOME/klipper/scripts/klippy-requirements.txt" ] && \
      pip install -r "$HOME/klipper/scripts/klippy-requirements.txt" --no-cache-dir
  fi

  if [ -d "$HOME/moonraker-env" ] && [ -d "$HOME/moonraker" ]; then
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    source "$HOME/moonraker-env/bin/activate"
    pip install -U pip setuptools wheel --no-cache-dir
    [ -f "$HOME/moonraker/scripts/moonraker-requirements.txt" ] && \
      pip install -r "$HOME/moonraker/scripts/moonraker-requirements.txt" --no-cache-dir
  fi
'


# Keep the image lean
echo 'APT::Install-Recommends "0"; APT::Install-Suggests "0";' >/etc/apt/apt.conf.d/99norecommends
cat >/etc/dpkg/dpkg.cfg.d/99nodoc <<'EOF'
path-exclude=/usr/share/doc/*
path-exclude=/usr/share/man/*
path-exclude=/usr/share/locale/*
path-include=/usr/share/locale/en*
EOF

# Display a custom Splashscreen when booting the Rpi
if [ "$FULLPAGEOS_CUSTOM_SPLASHSCREEN" == "yes" ]
then
    apt-get install -y fbi
    if [ "${BASE_BOARD}" == raspberrypi* ]; then
        sed -i 's/$/ logo.nologo consoleblank=0 loglevel=0 quiet/' /"${BASE_BOOT_MOUNT_PATH}"/cmdline.txt
    fi
    echo "disable_splash=1" >> /"${BASE_BOOT_MOUNT_PATH}"/config.txt
    systemctl enable splashscreen.service
    systemctl disable getty@tty1
fi

remove_extra=$(remove_if_installed scratch squeak-plugins-scratch squeak-vm python-minecraftpi minecraft-pi sonic-pi oracle-java8-jdk bluej greenfoot libreoffice-common libreoffice-core freepats)

apt-get remove -y --purge  $remove_extra
apt-get autoremove -y

step_start "Base Package Install"
# apt-get tools
apt-get -y --force-yes install git screen checkinstall avahi-daemon libavahi-compat-libdnssd1 xterm xdotool vim expect feh pulseaudio
step_end

if [ "$FULLPAGEOS_INCLUDE_CHROMIUM" == "yes" ]
then
    step_start "Chromium Install"
    apt-get install -y --force-yes chromium-browser
    sed -i 's@%BROWSER_START_SCRIPT%@/opt/custompios/scripts/start_chromium_browser@g' /opt/custompios/scripts/run_onepageos
    step_end
fi

# Install web stack (optional lighttpd)
if [ "$FULLPAGEOS_INCLUDE_LIGHTTPD" == "yes" ]
then
    step_start "Lighttpd/Web Stack Setup"
    apt-get install -y lighttpd php-common php-cgi php
    lighty-enable-mod fastcgi-php
    chown -R www-data:www-data /var/www/html
    chmod 775 /var/www/html
    usermod -a -G www-data pi
    systemctl enable clear_lighttpd_cache.service
    pushd /var/www/html
        if [ "$FULLPAGEOS_INCLUDE_DASHBOARD" == "yes" ]
        then
            gitclone FULLPAGEOS_DASHBOARD_REPO FullPageDashboard
            chown -R pi:pi FullPageDashboard
            chown -R www-data:www-data FullPageDashboard
            chmod 775 FullPageDashboard
            pushd FullPageDashboard
                sed -i "s@'INIT_URL_PATH', __DIR__ . '/init.txt'@'INIT_URL_PATH', '/"${BASE_BOOT_MOUNT_PATH}"/fullpagedashboard.txt'@g" config.php
            popd
        fi
        if [ "$FULLPAGEOS_INCLUDE_WELCOME" == "yes" ]
        then
            gitclone FULLPAGEOS_WELCOME_REPO welcome
            chown -R www-data:www-data welcome
        fi
    popd
    echo "enabled" > /"${BASE_BOOT_MOUNT_PATH}"/check_for_httpd
    step_end
else
    echo "disabled" > /"${BASE_BOOT_MOUNT_PATH}"/check_for_httpd
fi

# override timezone
if [ "$FULLPAGEOS_OVERRIDE_TIMEZONE" != "default" ]
then
    ln -fs /usr/share/zoneinfo/"$FULLPAGEOS_OVERRIDE_TIMEZONE" /etc/localtime
    dpkg-reconfigure -f noninteractive tzdata
fi

# override locale
if [ "$FULLPAGEOS_OVERRIDE_LOCALE" != "default" ]
then
    sed -i '/^#.* '"$FULLPAGEOS_OVERRIDE_LOCALE"' /s/^# //' /etc/locale.gen
    locale-gen
    update-locale LANG="$FULLPAGEOS_OVERRIDE_LOCALE"
fi

# override keyboard model and layout
if [ "$FULLPAGEOS_OVERRIDE_KBD_MODEL" != "default" ]
then
    sed -i 's/^XKBMODEL=.*/XKBMODEL="'$FULLPAGEOS_OVERRIDE_KBD_MODEL'"/' /etc/default/keyboard
fi
if [ "$FULLPAGEOS_OVERRIDE_KBD_LAYOUT" != "default" ]
then
    sed -i 's/^XKBLAYOUT=.*/XKBLAYOUT="'$FULLPAGEOS_OVERRIDE_KBD_LAYOUT'"/' /etc/default/keyboard
fi
if [ "$FULLPAGEOS_OVERRIDE_KBD_MODEL" != "default" ] || [ "$FULLPAGEOS_OVERRIDE_KBD_LAYOUT" != "default" ]
then
    setupcon -k --save-only
fi

# Add emoji support
sudo -u "${BASE_USER}" mkdir -p /home/"${BASE_USER}"/.fonts
sudo -u "${BASE_USER}" wget --directory-prefix /home/"${BASE_USER}"/.fonts https://github.com/googlefonts/noto-emoji/raw/main/fonts/NotoColorEmoji.ttf

# override password
if [ "$FULLPAGEOS_OVERRIDE_PASSWORD" != "default" ]
then
    echo "${BASE_USER}:$FULLPAGEOS_OVERRIDE_PASSWORD" | chpasswd
fi

# Setup x11vnc
if [ "$FULLPAGEOS_INCLUDE_X11VNC"  == "yes" ]
then
    apt-get install -y --force-yes x11vnc
    mkdir -p /opt/custompios/vnc
    chown "${BASE_USER}":"${BASE_USER}" /opt/custompios/vnc
    if [ "$FULLPAGEOS_OVERRIDE_PASSWORD" != "default" ]
    then
        sudo -u "${BASE_USER}" /opt/custompios/scripts/setX11vncPass "$FULLPAGEOS_OVERRIDE_PASSWORD"
        sync
        if [ ! -f /opt/custompios/vnc/passwd ] || [ ! -s /opt/custompios/vnc/passwd ]; then
          echo "/opt/custompios/vnc/passwd was not created. Trying again."
          sudo -u "${BASE_USER}" /opt/custompios/scripts/setX11vncPass "$FULLPAGEOS_OVERRIDE_PASSWORD"
          sync
          if [ ! -f /opt/custompios/vnc/passwd ] || [ ! -s /opt/custompios/vnc/passwd ]; then
            echo "Failed to set a VNC password. Aborting build."
            exit 1
           fi
        fi
    else
        sudo -u "${BASE_USER}" /opt/custompios/scripts/setX11vncPass raspberry
        sync
        if [ ! -f /opt/custompios/vnc/passwd ] || [ ! -s /opt/custompios/vnc/passwd ]; then
          echo "/opt/custompios/vnc/passwd was not created. Trying again."
          sudo -u "${BASE_USER}" /opt/custompios/scripts/setX11vncPass raspberry
          sync
          if [ ! -f /opt/custompios/vnc/passwd ] || [ ! -s /opt/custompios/vnc/passwd ]; then
            echo "Failed to set a VNC password. Aborting build."
            exit 1
          fi
        fi
    fi
    ls -l /opt/custompios/vnc/passwd
    systemctl enable x11vnc.service
fi

# Toolchains (from docs - Klipper deps)
apt-get install -y --no-install-recommends \
  python3-virtualenv python3-venv python3-dev libffi-dev build-essential libncurses-dev \
  avrdude gcc-avr binutils-avr avr-libc stm32flash dfu-util \
  libnewlib-arm-none-eabi gcc-arm-none-eabi binutils-arm-none-eabi \
  libusb-1.0-0-dev libusb-1.0-0 ca-certificates unzip curl vlc

###############################################################################
### Mainsail Manual Setup (Klipper + Moonraker + NGINX + Mainsail static) #####
### (Leaves ~/printer_data/config/* untouched)                               ###
###############################################################################

# 0) Base packages required by the guide (git, unzip already present above)
apt-get install -y git unzip

# Moonraker additional deps (Bookworm set)
apt-get update
apt-get install -y \
  libopenjp2-7 python3-libgpiod curl libcurl4-openssl-dev libssl-dev \
  liblmdb-dev libsodium-dev zlib1g-dev libjpeg-dev packagekit wireless-tools \
  python3-git

# 1) Create the directory structure (NO config/)
sudo -u "${BASE_USER}" bash -lc 'mkdir -p ~/printer_data/{logs,gcodes,systemd,comms}'

# 2) Clone Klipper and create its venv
step_start "Klipper Clone & Venv"
sudo -u "${BASE_USER}" bash -lc '
  set -e
  cd ~
  # Only clone if not seeded from cache
  if [ ! -d "$HOME/klipper/.git" ]; then
    echo "Cloning Klipper (no cache)..."
    git clone --depth 1 https://github.com/Klipper3d/klipper
  else
    echo "Klipper already present (from cache or previous run)"
    cd klipper && git fetch --all -p && git reset --hard origin/master
  fi
  cd ~
  # Only create venv if not seeded from cache
  if [ ! -d "$HOME/klippy-env/bin" ]; then
    echo "Creating klippy-env (no cache)..."
    virtualenv -p python3 ./klippy-env
    ./klippy-env/bin/pip install -r ./klipper/scripts/klippy-requirements.txt
    # Write hash on first creation
    REQS_HASH=$(md5sum ./klipper/scripts/klippy-requirements.txt | cut -d" " -f1)
    echo "$REQS_HASH" > "$HOME/klippy-env/.requirements-hash"
  else
    echo "klippy-env already present (from cache)"
    # Only reinstall requirements if they changed
    REQS_FILE="./klipper/scripts/klippy-requirements.txt"
    REQS_HASH=$(md5sum "$REQS_FILE" | cut -d" " -f1)
    HASH_FILE="$HOME/klippy-env/.requirements-hash"
    if [ ! -f "$HASH_FILE" ] || [ "$(cat "$HASH_FILE")" != "$REQS_HASH" ]; then
      echo "Requirements changed, updating packages..."
      ./klippy-env/bin/pip install -r "$REQS_FILE"
      echo "$REQS_HASH" > "$HASH_FILE"
    else
      echo "Requirements unchanged, skipping pip install"
    fi
  fi
'
step_end
# 2.5) Drop a fixed Klipper .config for firmware builds
sudo -u "${BASE_USER}" bash -lc '
  set -e
  KLIPPER_DIR="$HOME/klipper"
  CONFIG_PATH="$KLIPPER_DIR/.config"

  # Ensure dir exists (it should from the clone above, but be idempotent)
  mkdir -p "$KLIPPER_DIR"

  # Write as the user (avoid host/chroot redirection issues)
  cat <<'"'EOF'"' | tee "$CONFIG_PATH" >/dev/null
# Klipper firmware config: Atmel SAM3/SAM4 -> SAM3X8E, USB CDC
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_ATSAM=y
CONFIG_BOARD_DIRECTORY="atsam"
CONFIG_MCU="sam3x8e"
CONFIG_CLOCK_REF_12M=y
CONFIG_USBSERIAL=y
EOF

  chmod 0644 "$CONFIG_PATH"
'
# 2.6) Non-interactive Kconfig defaults, then (optionally) build firmware
step_start "Klipper Firmware Build"
sudo -u "${BASE_USER}" bash -lc '
  set -e
  cd ~/klipper

  # Fill in any missing options from defaults (no TUI prompts)
  make olddefconfig

  # Only rebuild if .config changed or out/ is missing
  CONFIG_HASH=$(md5sum .config | cut -d" " -f1)
  HASH_FILE="out/.config-hash"
  
  if [ ! -f "out/klipper.bin" ] || [ ! -f "$HASH_FILE" ] || [ "$(cat "$HASH_FILE")" != "$CONFIG_HASH" ]; then
    echo "Config changed or firmware missing, rebuilding..."
    make clean
    make -j"$(nproc)"
    mkdir -p out
    echo "$CONFIG_HASH" > "$HASH_FILE"
  else
    echo "Firmware already built with current config, skipping"
  fi

  ls -l out || true
'
step_end

# 3) Klipper systemd unit and env
cat >/etc/systemd/system/klipper.service <<EOF
[Unit]
Description=Klipper 3D Printer Firmware SV1
Documentation=https://www.klipper3d.org/
After=network-online.target
Wants=udev.target

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=${BASE_USER}
RemainAfterExit=yes
WorkingDirectory=/home/${BASE_USER}/klipper
EnvironmentFile=/home/${BASE_USER}/printer_data/systemd/klipper.env
ExecStart=/home/${BASE_USER}/klippy-env/bin/python \$KLIPPER_ARGS
Restart=always
RestartSec=10
EOF

sudo -u "${BASE_USER}" bash -lc 'cat > ~/printer_data/systemd/klipper.env <<EOF
KLIPPER_ARGS="/home/'"${BASE_USER}"'/klipper/klippy/klippy.py /home/'"${BASE_USER}"'/printer_data/config/printer.cfg -l /home/'"${BASE_USER}"'/printer_data/logs/klippy.log -I /home/'"${BASE_USER}"'/printer_data/comms/klippy.serial -a /home/'"${BASE_USER}"'/printer_data/comms/klippy.sock"
EOF'
systemctl enable klipper.service


# 4) Moonraker - manual install (no installer script)
step_start "Moonraker Clone & Venv"
sudo -u "${BASE_USER}" bash -lc '
  set -e
  cd ~
  # Only clone if not seeded from cache
  if [ ! -d "$HOME/moonraker/.git" ]; then
    echo "Cloning Moonraker (no cache)..."
    git clone --depth 1 https://github.com/Arksine/moonraker.git
  else
    echo "Moonraker already present (from cache)"
    cd moonraker && git fetch --all -p && git reset --hard origin/master
  fi

  # Make data dirs (but do NOT create/touch ~/printer_data/config)
  mkdir -p ~/printer_data/{logs,systemd,comms,gcodes}

  # Create Moonraker venv and install requirements
  if [ ! -d "$HOME/moonraker-env/bin" ]; then
    echo "Creating moonraker-env (no cache)..."
    python3 -m venv ~/moonraker-env
    ~/moonraker-env/bin/pip install --upgrade pip wheel
    REQS_FILE="$HOME/moonraker/scripts/moonraker-requirements.txt"
    ~/moonraker-env/bin/pip install -r "$REQS_FILE"
    # Write hash on first creation
    REQS_HASH=$(md5sum "$REQS_FILE" | cut -d" " -f1)
    echo "$REQS_HASH" > "$HOME/moonraker-env/.requirements-hash"
  else
    echo "moonraker-env already present (from cache)"
    # Only reinstall requirements if they changed
    REQS_FILE="$HOME/moonraker/scripts/moonraker-requirements.txt"
    REQS_HASH=$(md5sum "$REQS_FILE" | cut -d" " -f1)
    HASH_FILE="$HOME/moonraker-env/.requirements-hash"
    if [ ! -f "$HASH_FILE" ] || [ "$(cat "$HASH_FILE")" != "$REQS_HASH" ]; then
      echo "Requirements changed, updating packages..."
      ~/moonraker-env/bin/pip install --upgrade pip wheel
      ~/moonraker-env/bin/pip install -r "$REQS_FILE"
      echo "$REQS_HASH" > "$HASH_FILE"
    else
      echo "Requirements unchanged, skipping pip install"
    fi
  fi
'
step_end

# --- Make manual install equivalent to the official installer ---

# 1) Ensure the policy group exists and the user is in it
getent group moonraker-admin >/dev/null 2>&1 || groupadd --system moonraker-admin
usermod -aG moonraker-admin "${BASE_USER}"

# 2) Ensure env dir exists (owned by the user)
sudo -u "${BASE_USER}" mkdir -p /home/"${BASE_USER}"/printer_data/systemd

# 3) Write the environment file if missing (do not overwrite if you already ship one)
if [ ! -f /home/"${BASE_USER}"/printer_data/systemd/moonraker.env ]; then
  sudo -u "${BASE_USER}" bash -lc 'cat > ~/printer_data/systemd/moonraker.env <<EOF
MOONRAKER_ARGS="/home/'"${BASE_USER}"'/moonraker/moonraker/moonraker.py -d /home/'"${BASE_USER}"'/printer_data"
EOF'
fi

# 4) Systemd unit (points to user's paths)
cat >/etc/systemd/system/moonraker.service <<EOF
[Unit]
Description=API Server for Klipper SV1
Requires=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=${BASE_USER}
SupplementaryGroups=moonraker-admin
WorkingDirectory=/home/${BASE_USER}/moonraker
EnvironmentFile=/home/${BASE_USER}/printer_data/systemd/moonraker.env
ExecStart=/home/${BASE_USER}/moonraker-env/bin/python \$MOONRAKER_ARGS
Restart=always
RestartSec=10
EOF

# --- Moonraker PolicyKit rules (no package installs; chroot-safe) ---
# --- Moonraker PolicyKit wiring (non-interactive, chroot-safe) ---

# 1) Ensure polkit and dbus are installed (the agent will run on first boot)
step_start "PolicyKit/DBus Install"
apt-get install -y --no-install-recommends policykit-1 dbus

# 2) Create the policy group and add your user
getent group moonraker-admin >/dev/null 2>&1 || groupadd --system moonraker-admin
usermod -aG moonraker-admin "${BASE_USER}"
step_end

# 3) Install the Moonraker polkit rule (from the repo if present; otherwise write a minimal rule)
RULE_DST="/etc/polkit-1/rules.d/50-moonraker.rules"
RULE_SRC="/home/${BASE_USER}/moonraker/scripts/policykit/50-moonraker.rules"

if [ -f "${RULE_SRC}" ]; then
  install -m 0644 -o root -g root "${RULE_SRC}" "${RULE_DST}"
else
  # Fallback rule that allows common actions for the moonraker-admin group
  cat > "${RULE_DST}" <<'EOF'
polkit.addRule(function(action, subject) {
  var ok = subject.isInGroup("moonraker-admin");
  var acts = [
    "org.freedesktop.systemd1.manage-units",
    "org.freedesktop.systemd1.manage-unit-files",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.reboot-multiple-sessions",
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.power-off-multiple-sessions",
    "org.freedesktop.timedate1.set-time",
    "org.freedesktop.timedate1.set-timezone",
    "org.freedesktop.hostname1.set-static-hostname",
    "org.freedesktop.packagekit.system-sources-refresh",
    "org.freedesktop.packagekit.package-install",
    "org.freedesktop.packagekit.system-update"
  ];
  if (ok && acts.indexOf(action.id) >= 0) {
    return polkit.Result.YES;
  }
});
EOF
  chown root:root "${RULE_DST}"
  chmod 0644 "${RULE_DST}"
fi

# 4) Make sure Moonraker runs with the group at runtime
# (Your unit already has 'SupplementaryGroups=moonraker-admin'; if not, add it.)
if ! grep -q '^SupplementaryGroups=.*moonraker-admin' /etc/systemd/system/moonraker.service; then
  sed -i 's/^\[Service\]/[Service]\nSupplementaryGroups=moonraker-admin/' /etc/systemd/system/moonraker.service
fi

# 5) Reload rules and systemd (polkit will pick up the new rule on boot)
udevadm control --reload-rules || true
systemctl daemon-reload || true
# (polkitd will start on first boot; restarting it in chroot is optional)

###############################################################################
# USB automount (USB partitions only) + single gcodes link "usb-drive"
###############################################################################

# Install USB FS helpers and the automounter package
step_start "USB Automount Setup"
apt-get install -y --no-install-recommends exfatprogs ntfs-3g ca-certificates wget
update-ca-certificates || true

# Install pi-usb-automount (mounts first drive at /media/usb0)
TMPDEB="/tmp/pi-usb-automount.deb"
wget -q -O "$TMPDEB" https://github.com/fasteddy516/pi-usb-automount/releases/latest/download/pi-usb-automount.deb
dpkg -i "$TMPDEB" || apt-get -f install -y
rm -f "$TMPDEB"
udevadm control --reload-rules || true

# Ensure gcodes dirs exist for both common layouts
install -d -m 775 "/home/${BASE_USER}/printer_data/gcodes" "/printer_data/gcodes"

# Make stable symlinks that always point to /media/usb0 (no per-plug updates needed)
ln -sfn /media/usb0 "/home/${BASE_USER}/printer_data/gcodes/usb-drive"
ln -sfn /media/usb0 "/printer_data/gcodes/usb-drive"

# Recreate those symlinks at boot (in case something wipes them)
cat >/etc/tmpfiles.d/usb-drive.conf <<'EOF'
