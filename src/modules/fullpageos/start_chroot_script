# --- Minimal Crowsnest unattended install (no .config) ---

set -xe
export DEBIAN_FRONTEND=noninteractive
BASE_USER="pi"
REPO="https://github.com/mainsail-crew/crowsnest.git"

apt-get update
apt-get install -y --no-install-recommends git ca-certificates

# Clone/update
install -d -o "$BASE_USER" -g "$BASE_USER" "/home/$BASE_USER"
if [ ! -d "/home/$BASE_USER/crowsnest/.git" ]; then
  runuser -u "$BASE_USER" -- git clone "$REPO" "/home/$BASE_USER/crowsnest"
else
  runuser -u "$BASE_USER" -- bash -lc '
    cd ~/crowsnest
    git fetch --all -p || true
    (git rev-parse --verify origin/master >/dev/null 2>&1 && git reset --hard origin/master) || \
    (git rev-parse --verify origin/main   >/dev/null 2>&1 && git reset --hard origin/main)  || true
  '
fi

# Pick pkg list (RPi vs generic) and install deps Crowsnest expects
if grep -qiE "raspbian|raspberry pi os" /etc/os-release 2>/dev/null; then
  INSTALL_SCRIPT="/home/$BASE_USER/crowsnest/tools/libs/pkglist-rpi.sh"
else
  INSTALL_SCRIPT="/home/$BASE_USER/crowsnest/tools/libs/pkglist-generic.sh"
fi
PKGLIST=$(bash -lc "source '$INSTALL_SCRIPT'; echo \"\$PKGLIST\"")
read -ra PKGARRAY <<< "$PKGLIST"
apt-get install -y "${PKGARRAY[@]}"

# Make sure runtime dirs exist
install -d -o "$BASE_USER" -g "$BASE_USER" \
  "/home/$BASE_USER/printer_data/config" \
  "/home/$BASE_USER/printer_data/logs" \
  "/home/$BASE_USER/printer_data/systemd"

# Unattended install with your overrides (no .config file)
export CROWSNEST_UNATTENDED=1
export CROWSNEST_ADD_CROWSNEST_MOONRAKER=0
export BASE_USER="pi"
export CROWSNEST_USTREAMER_REPO_SHIP="https://github.com/pikvm/ustreamer.git"
export CROWSNEST_USTREAMER_REPO_BRANCH="v6.36"
export CROWSNEST_CAMERA_STREAMER_REPO_SHIP="https://github.com/mryel00/camera-streamer.git"
export CROWSNEST_CAMERA_STREAMER_REPO_BRANCH="main"
export CROWSNEST_CONFIG_PATH="/home/pi/printer_data/config"
export CROWSNEST_LOG_PATH="/home/pi/printer_data/logs"
export CROWSNEST_ENV_PATH="/home/pi/printer_data/systemd"

runuser -u "$BASE_USER" -- bash -lc 'cd ~/crowsnest && make install'

# Optional: enable on first boot (safe even in chroot)
if command -v systemctl >/dev/null 2>&1; then systemctl enable crowsnest || true; fi
mkdir -p /etc/systemd/system/multi-user.target.wants
[ -e /lib/systemd/system/crowsnest.service ] && ln -sf /lib/systemd/system/crowsnest.service /etc/systemd/system/multi-user.target.wants/crowsnest.service || true



